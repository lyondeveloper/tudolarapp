# Copy this file to .env and fill in the values. Never commit the real .env.
#
# API runtime uses the restricted, non-superuser role created by docker/initdb.
#   DATABASE_URL=postgresql://tudolar_app:tudolar_app@127.0.0.1:5433/tudolar
# Optional runtime URL for a local disposable database ending in `_test`:
#   TUDOLAR_TEST_DATABASE_URL=postgresql://tudolar_app:tudolar_app@127.0.0.1:5433/tudolar_test
#
# Prisma migrations and E2E provisioning/reset use MIGRATION_DATABASE_URL from
# a separate `.env.migration` file. Never put that maintenance credential in
# this runtime `.env`; see `.env.migration.example`.
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TUDOLAR
WEBAUTHN_ORIGINS=http://localhost:3000
PHONE_OTP_PEPPER=
EMAIL_DELIVERY_MODE=unavailable
SMS_DELIVERY_MODE=unavailable
