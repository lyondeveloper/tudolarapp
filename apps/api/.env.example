# Copy this file to .env and fill in the values. Never commit the real .env.
#
# Local development database (docker compose up -d at the repository root):
#   DATABASE_URL=postgresql://tudolar:tudolar@127.0.0.1:5432/tudolar
# Disposable database for `npm run test:e2e` (localhost, name must end in _test):
#   TUDOLAR_TEST_DATABASE_URL=postgresql://tudolar:tudolar@127.0.0.1:5432/tudolar_test
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TUDOLAR
WEBAUTHN_ORIGINS=http://localhost:3000
PHONE_OTP_PEPPER=
EMAIL_DELIVERY_MODE=unavailable
SMS_DELIVERY_MODE=unavailable
