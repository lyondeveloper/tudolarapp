// Prisma ORM 7 is the single owner of the database schema and of migrations.
// node-pg-migrate was removed; do not reintroduce a second migration runner.
//
// Two classes of object cannot be expressed in this file:
//   * CHECK constraints (Prisma Migrate does not support them yet) — appended by
//     hand to the generated migration SQL; every future `prisma migrate dev`
//     must preserve them.
//   * the PostGIS extension — created by the `--create-only` migration
//     20261017190000_add_postgis_extension, which needs a privileged migration
//     role. docker/initdb/01-create-databases.sql stays a local convenience;
//     Prisma Migrate is the authority. The API only *verifies* the extension at
//     startup (src/database/postgis-extension.ts) and never creates it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"

  // Required to declare the partial unique indexes on `users`.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName        String    @map("display_name")
  username           String?
  usernameNormalized String?   @map("username_normalized")
  email              String?
  emailNormalized    String?   @map("email_normalized")
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash       String?   @map("password_hash")
  phoneE164          String?   @map("phone_e164")
  phoneVerifiedAt    DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  accountStatus      String    @default("active") @map("account_status")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  passkeyCredentials PasskeyCredential[]
  authSessions       AuthSession[]
  authChallenges     AuthChallenge[]
  emailActionTokens  EmailActionToken[]
  phoneChallenges    PhoneVerificationChallenge[]

  @@unique([usernameNormalized], map: "users_username_normalized_uq", where: raw("username_normalized IS NOT NULL"))
  @@unique([emailNormalized], map: "users_email_normalized_uq", where: raw("email_normalized IS NOT NULL"))
  @@unique([phoneE164], map: "users_phone_e164_uq", where: raw("phone_e164 IS NOT NULL"))
  @@map("users")
}

model PasskeyCredential {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  credentialId     String    @unique @map("credential_id")
  publicKey        Bytes     @map("public_key")
  signatureCounter BigInt    @default(0) @map("signature_counter")
  transports       String[]  @default([])
  deviceType       String?   @map("device_type")
  backedUp         Boolean   @default(false) @map("backed_up")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model AuthSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenFamilyId       String    @map("token_family_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId, revokedAt])
  @@map("auth_sessions")
}

model AuthChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    String
  challenge  String
  userId     String?   @map("user_id") @db.Uuid
  context    Json      @default("{}")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt])
  @@map("auth_challenges")
}

model EmailActionToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  context    Json      @default("{}")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("email_action_tokens")
}

model PhoneVerificationChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  phoneE164  String    @map("phone_e164")
  codeHmac   String    @map("code_hmac")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("phone_verification_challenges")
}

model OfferTermsVersion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId       String    @map("offer_id") @db.Uuid
  version       Int
  pairId        String    @map("pair_id")
  giveAmount    Decimal   @map("give_amount") @db.Decimal(24, 6)
  receiveAmount Decimal   @map("receive_amount") @db.Decimal(24, 6)
  rate          Decimal?  @db.Decimal(24, 8)
  marginPct     Decimal   @map("margin_pct") @db.Decimal(5, 2)
  minAmount     Decimal   @map("min_amount") @db.Decimal(24, 6)
  maxAmount     Decimal   @map("max_amount") @db.Decimal(24, 6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([offerId, version], map: "offer_terms_versions_offer_id_version_uq")
  @@map("offer_terms_versions")
}
